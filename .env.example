# Copy to .env and fill values. Never commit .env.
# Paper-only v1 — do NOT place live Alpaca credentials on the host.
# Secrets must be in .env; do not export empty ALPACA_* in the shell
# (empty shell/env vars can blank out values Compose would otherwise load).

TZ=America/Denver
TRADING_PAUSED=true

# Required before research against SEC EDGAR (identify yourself per SEC guidance).
SEC_USER_AGENT=DividendAgent/0.1 (contact: you@example.com)

# Alpaca PAPER credentials only. Leave empty for dry-run skeleton without broker.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# Market data (Milestone B) — exact data host; reuses paper keys (read-only).
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_OPTION_FEED=indicative

# Image tag used by compose.yaml (explicit versions preferred over :latest).
IMAGE_TAG=0.1.0

# Scheduler loop (container entrypoint)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SEC=3600
SCHEDULER_JOBS=startup,trading_day
# Set true only after paper keys are configured — otherwise container still boots
# but startup job cycles will log failures until verify succeeds.
REQUIRE_PAPER_ON_START=false

# Optional TrueNAS SCALE bind mounts (compose.truenas.yaml)
# Paths must be writable by UID/GID 10001.
# TRUENAS_DATA_PATH=/mnt/tank/apps/dividend-agent/data
# TRUENAS_REPORTS_PATH=/mnt/tank/apps/dividend-agent/reports
# TRUENAS_LOGS_PATH=/mnt/tank/apps/dividend-agent/logs
# TRUENAS_CONFIG_PATH=/mnt/tank/apps/dividend-agent/config/strategy.yaml
